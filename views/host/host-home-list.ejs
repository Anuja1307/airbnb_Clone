<%- include('../partials/head') %>
</head>
<body class="bg-gray-50 min-h-screen">

   <%- include('../partials/nav') %>

    <div class="container mx-auto py-10">
      
      
      <div id="homes-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <div class="col-span-full mb-4">
          <h3 class="text-2xl font-semibold text-gray-700 mb-4">Hey host, here are your homes:</h3>
        </div>
        <% homes.forEach((home) => { %>
          <div class="bg-white rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 p-6 flex flex-col h-full">
            <h2 class="text-xl font-bold text-gray-900 mb-3"><%= home.homename %></h2>
            
            <img src="<%= home.photoURL %>" alt="home image" class="w-full h-48 object-cover rounded-lg mb-4"/>
            
            <div class="flex-grow space-y-2 mb-4">
              <p class="text-gray-600"><span class="font-semibold text-gray-800">Location:</span> <%= home.location %></p>
              <p class="text-gray-600"><span class="font-semibold text-gray-800">Rating:</span> <%= home.rating %> ⭐</p>
              <p class="text-2xl font-bold text-green-600 mt-2">💰<%= home.price %></p>
            </div>
            
            <a href="/host/edit_Home/<%= home._id %>/?editing=true" class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-200">
              Edit
            </a>
            <br/>
            <form action="/host/delete_home/<%= home._id %>" method="post">
                <button class="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition-colors duration-200">
                     Delete
                </button>
            </form>
             
          </div>
         
        <% }) %>

      
      </div>
    </div>
  </body>
</body>
</html>
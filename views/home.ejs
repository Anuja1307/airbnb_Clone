<%- include('partials/head') %>
</head>
<body>
  <body class="bg-gray-50 min-h-screen">

   <%- include('partials/nav') %>

    <div class="container mx-auto py-10">
      <div class="flex justify-between items-center mb-8">
        <h1 class="text-4xl font-bold text-gray-800">Available Homes</h1>
        <a href="/host/add-home" class="px-6 py-2 bg-red-500 text-white rounded-full hover:bg-red-600 transition">Add a New Home</a>
      </div>
      <div id="homes-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
        <div class="col-span-full mb-4">
          <h3 class="text-2xl font-semibold text-gray-700 mb-4">Registered Homes:</h3>
        </div>
        <% homes.forEach((home) => { %>
          <div class="bg-white rounded-lg shadow-md p-6 flex flex-col items-start">
            <span class="text-lg font-medium text-gray-800"> Home name :<%= home.homename %></span>

            <span class="text-lg font-medium text-gray-800">Price :<%= home.price %></span>

            <span class="text-lg font-medium text-gray-800">Location :<%= home.location %></span>

            <span class="text-lg font-medium text-gray-800">Rating :<%= home.rating %></span>
             
            <img src="<%= home.photo %>" alt="home image" style="width:100%; height:200px; object-fit:cover; border-radius:8px;"/>
          </div>
        <% }) %>

      
      </div>
    </div>
  </body>
</body>
</html>
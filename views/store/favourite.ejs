<%- include('../partials/head') %>
</head>
<body>
  <body class="bg-gray-50 min-h-screen">

   <%- include('../partials/nav') %>
  <div class="container mx-auto py-10">
   
    <div id="homes-list" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
    <div class="col-span-full mb-4">
      <h3 class="text-2xl font-semibold text-gray-700 mb-4">Here are your Favourites</h3>
    </div>
    <% homes.forEach((home) => { %>
      <div class="bg-white rounded-lg shadow-md hover:shadow-lg p-6 flex flex-col items-start transition-shadow duration-300">
      <span class="text-lg font-medium text-gray-800">Home name: <%= home.homename %></span>

      <span class="text-lg font-medium text-gray-800 mt-2">Price: 💰<%= home.price %></span>

      <span class="text-lg font-medium text-gray-800 mt-2">Location: <%= home.location %></span>

      <span class="text-lg font-medium text-gray-800 mt-2">Rating: <%= home.rating %> ⭐</span>
       
      <img src="<%= home.photo %>" alt="home image" class="w-full h-48 object-cover rounded-lg mt-4"/>

      <button class="bg-green-500 hover:bg-green-600 text-white font-semibold py-2 px-6 rounded-md mt-4 w-full transition-colors duration-200">Book</button>

      <form action="/favourites/delete/<%= home.homeId %>" method="post">
        <button class="bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-6 rounded-md mt-4 w-full transition-colors duration-200">Remove from favourites</button>
      </form>

      </div>
         
        <% }) %>

      
      </div>
    </div>
  </body>
</body>
</html>
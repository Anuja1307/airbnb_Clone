<%- include('../partials/head') %>
</head>
<body>
  <body class="bg-gray-50 min-h-screen">

   <%- include('../partials/nav') %>



    <div class="container mx-auto py-10 px-4">
        <div class="flex justify-between items-center mb-8">
            <h1 class="text-4xl font-bold text-gray-800">Available Homes</h1>
            <a href="/host/add_Home" class="px-6 py-2 bg-red-500 text-white rounded-full hover:bg-red-600 transition">Add a New Home</a>
        </div>

        <h3 class="text-2xl font-semibold text-gray-700 mb-6">Welcome to Airbnb</h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8">
            <% homes.forEach((home) => { %>
                <div class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition duration-300">
                    
                    <img src="<%= home.photoURL %>" alt="home image" class="w-full h-52 object-cover"/>
                    
                    <div class="p-5">
                        <h2 class="text-xl font-bold text-gray-800 mb-2"><%= home.homename %></h2>
                        
                        <div class="flex items-center gap-2 text-gray-600 mb-1">
                            <span>📍</span>
                            <span><%= home.location %></span>
                        </div>

                        <div class="flex items-center gap-2 text-gray-600 mb-1">
                            <span>⭐</span>
                            <span><%= home.rating %> / 5</span>
                        </div>

                        <div class="flex items-center gap-2 text-gray-800 font-semibold mb-4">
                            <span>💰</span>
                            <span>₹<%= home.price %> / night</span>
                        </div>

                        <button class="w-full bg-green-500 text-white py-2 mb-2 rounded-full hover:bg-red-600 transition font-semibold">
                            Book Now
                        </button>

                            <%- include("../partials/favourites",{home:home}) %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

</body>
</html>

      
      </div>
    </div>
  </body>
</body>
</html>
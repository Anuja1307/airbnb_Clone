
      <% if(errorMessage && errorMessage.length > 0) { %>
            <div class="error-alert bg-red-50 border border-red-200 rounded-lg p-4 mb-5 shadow-lg shadow-red-200">
                <ul class="list-none p-0 m-0">
                    <% errorMessage.forEach(error => { console.log(error) %>
                        <li class="text-red-600 text-sm font-medium mb-1"><%= error.msg %></li>
                    <% }) %>
                </ul>
            </div>
        <% } %>
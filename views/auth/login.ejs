<%- include('../partials/head') %>
<body class="bg-gray-50 flex flex-col items-center justify-center min-h-screen">

    <%- include('../partials/nav') %>

    <div class="bg-white rounded-xl shadow-lg p-8 w-full max-w-md mt-10">
        <h1 class="text-3xl font-bold text-gray-800 mb-6 text-center">
           Login
        </h1>

        <form action="/login" method="post" class="space-y-4">
        <%- include('../partials/errors') %>
            
            <input type="email" name="email" 
                
                placeholder="Enter email" required 
                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400" value="<% oldInput.email ? oldInput.email : '' %>"/>

            <input type="password" name="password" 
               
                placeholder="Enter your password" 
                class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400" required/>

           

            <button type="submit" class="w-full py-2 bg-red-500 text-white rounded-full font-semibold hover:bg-red-600 transition">
                Sign In 
            </button>
        </form>
    </div>

</body>
</html>